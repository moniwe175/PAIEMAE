# ─────────────────────────────────────────────────────────
# .env — configuração do sync_financeiro.py
# Renomeie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://ecwizjyflxcickbfzhcp.supabase.co
SUPABASE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# ── Google Sheets ─────────────────────────────────────────
# ID da planilha (pegue da URL: /spreadsheets/d/SEU_ID_AQUI/edit)
SHEET_ID=SEU_SHEET_ID_AQUI

# Nome exato da aba (ex: "CAIXA 01", "Planilha1")
# Deixe vazio para usar a primeira aba automaticamente
SHEET_NAME=

# Caminho para o arquivo JSON da Service Account do Google
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Intervalo de sync ─────────────────────────────────────
# Segundos entre cada ciclo de sincronização (padrão: 30)
SYNC_INTERVAL=30

# ── Mapeamento de colunas (0-indexado) ────────────────────
# Ajuste apenas se as colunas da sua planilha forem diferentes
COL_CLIENTE=0
COL_PROFISSIONAL=1
COL_CREDITO=2
COL_DEBITO=3
COL_DINHEIRO=4
COL_PIX=5
COL_COMANDA=7
