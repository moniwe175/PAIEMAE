# Banco interno da Evolution (use somente letras e números hexadecimais na senha)
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=TROQUE_POR_UM_HEX_ALEATORIO

# Chave privada da API; nunca coloque esta chave no React/Vite
AUTHENTICATION_API_KEY=TROQUE_POR_UM_HEX_ALEATORIO

# Instância WhatsApp criada automaticamente pelo worker
EVOLUTION_INSTANCE_NAME=paiemae

# Supabase: segredo exclusivo de backend (sb_secret_... ou service_role legado)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_TROQUE_AQUI

# Intervalos do worker
POLL_INTERVAL_MS=30000
CONNECTION_POLL_INTERVAL_MS=15000
MAX_EXPIRY_LAG_MS=3600000
EVOLUTION_REQUEST_TIMEOUT_MS=15000

TZ=America/Sao_Paulo
